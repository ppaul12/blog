---
---

[
{%- assign posts = site.posts | where: "layout", "post/travel" -%}
{%- assign journeys = "" | split: "," -%}
{%- for post in posts -%}
    {%- assign map_path = "/assets/src/" | append: post.slug | append: "/map.json" -%}
    {%- assign file = site.static_files | where: "path", map_path | first -%}
    {%- if file -%}
        {%- assign journeys = journeys | push: post -%}
    {%- endif -%}
{%- endfor -%}
{%- for post in journeys -%}
    {%- assign map_path = "/assets/src/" | append: post.slug | append: "/map.json" -%}
{
    "date": "{{ post.date | date:'%Y/%m' }}",
    "title": {{ post.title | strip_html | jsonify }},
    "subtitle": {{ post.subtitle | jsonify }},
    "link": "{{ post.url | relative_url }}",
    "json": "{{ map_path | relative_url }}"
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
